{"schemaVersion":1,"category":{"id":"java-spring","title":"Java & Spring","contentVersion":3},"topics":[{"id":"core-java","title":"Core Java","sections":[{"id":"language-basics","title":"Language Basics"},{"id":"oop-types","title":"Classes, Interfaces and Records"},{"id":"generics","title":"Generics and Type System"},{"id":"exceptions","title":"Exceptions"},{"id":"collections","title":"Collections and Streams"},{"id":"concurrency","title":"Concurrency and Memory Model"},{"id":"modules","title":"Packages and Modules"}]},{"id":"spring-boot","title":"Spring Boot","sections":[{"id":"auto-configuration","title":"Auto-configuration"},{"id":"dependency-injection","title":"Dependency Injection"},{"id":"configuration","title":"Externalized Configuration and Profiles"},{"id":"web","title":"Web and REST"},{"id":"data","title":"Data and Transactions"},{"id":"testing","title":"Testing"},{"id":"actuator","title":"Actuator and Operations"}]},{"id":"spring-security","title":"Spring Security","sections":[{"id":"security-fundamentals","title":"Security Fundamentals"}]},{"id":"spring-core","title":"Spring Core","sections":[{"id":"ioc-container","title":"IoC Container and Beans"},{"id":"aop-events","title":"AOP and Events"}]},{"id":"spring-data","title":"Spring Data","sections":[{"id":"repositories","title":"Repositories and Data Access"}]}],"questions":[{"id":"java-251","topicId":"core-java","sectionId":"modules","type":"single-choice","prompt":"What does `requires transitive` do?","options":[{"id":"a","text":"Make a dependency available to consumers of this module"},{"id":"b","text":"Declare a dependency only for compilation"},{"id":"c","text":"Exclude a module"},{"id":"d","text":"Export a package"}],"correctAnswer":"a","explanation":"requires transitive makes the dependency available to consumers of this module.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-252","topicId":"core-java","sectionId":"modules","type":"true-false","prompt":"`requires static` declares a dependency only needed at compile time.","options":[],"correctAnswer":true,"explanation":"requires static declares a compile-time-only dependency.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-253","topicId":"core-java","sectionId":"modules","type":"single-choice","prompt":"What does `opens ... to` do?","options":[{"id":"a","text":"Grant reflective access to specific modules"},{"id":"b","text":"Export a package to all modules"},{"id":"c","text":"Require a module"},{"id":"d","text":"Exclude a package"}],"correctAnswer":"a","explanation":"opens ... to grants reflective access to specific modules.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-254","topicId":"core-java","sectionId":"modules","type":"true-false","prompt":"`exports ... to` restricts exports to specific modules.","options":[],"correctAnswer":true,"explanation":"exports ... to restricts exports to specific modules.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-255","topicId":"core-java","sectionId":"modules","type":"single-choice","prompt":"What does `uses` declare in a module?","options":[{"id":"a","text":"A service interface the module consumes"},{"id":"b","text":"A service implementation the module provides"},{"id":"c","text":"A package export"},{"id":"d","text":"A module dependency"}],"correctAnswer":"a","explanation":"uses declares a service interface the module consumes.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-256","topicId":"core-java","sectionId":"modules","type":"true-false","prompt":"`provides ... with` declares a service implementation.","options":[],"correctAnswer":true,"explanation":"provides ... with declares a service implementation.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-257","topicId":"core-java","sectionId":"modules","type":"single-choice","prompt":"What does `module-info.java` contain?","options":[{"id":"a","text":"Module declarations such as requires, exports, and opens"},{"id":"b","text":"Class definitions"},{"id":"c","text":"Method implementations"},{"id":"d","text":"Package declarations only"}],"correctAnswer":"a","explanation":"module-info.java contains module declarations.","difficulty":"intermediate","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-258","topicId":"core-java","sectionId":"modules","type":"true-false","prompt":"A module can export the same package to multiple modules.","options":[],"correctAnswer":true,"explanation":"A module can export a package to multiple modules using a comma-separated list.","difficulty":"intermediate","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-259","topicId":"core-java","sectionId":"modules","type":"single-choice","prompt":"What does `java.base` provide?","options":[{"id":"a","text":"Foundational Java SE APIs"},{"id":"b","text":"Database drivers"},{"id":"c","text":"Web frameworks"},{"id":"d","text":"UI libraries"}],"correctAnswer":"a","explanation":"java.base provides foundational Java SE APIs.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/index.html"},{"id":"java-260","topicId":"core-java","sectionId":"modules","type":"true-false","prompt":"A module name must match the package name.","options":[],"correctAnswer":false,"explanation":"Module names and package names are distinct.","difficulty":"beginner","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-7.html"},{"id":"java-261","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `AtomicReference` provide?","options":[{"id":"a","text":"Atomic operations on an object reference"},{"id":"b","text":"Atomic operations on an int"},{"id":"c","text":"A lock"},{"id":"d","text":"A queue"}],"correctAnswer":"a","explanation":"AtomicReference provides atomic operations on an object reference.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/atomic/AtomicReference.html"},{"id":"java-262","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`AtomicLong` provides atomic operations on a long value.","options":[],"correctAnswer":true,"explanation":"AtomicLong provides atomic operations on a long.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/atomic/AtomicLong.html"},{"id":"java-263","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `LongAdder` do?","options":[{"id":"a","text":"Maintain a sum with better performance under contention"},{"id":"b","text":"Count elements"},{"id":"c","text":"Manage locks"},{"id":"d","text":"Schedule tasks"}],"correctAnswer":"a","explanation":"LongAdder maintains a sum with better performance under high contention.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/atomic/LongAdder.html"},{"id":"java-264","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`ConcurrentHashMap` is thread-safe for concurrent access.","options":[],"correctAnswer":true,"explanation":"ConcurrentHashMap is designed for thread-safe concurrent access.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/ConcurrentHashMap.html"},{"id":"java-265","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `CopyOnWriteArrayList` do?","options":[{"id":"a","text":"Create a new copy of the array on each write"},{"id":"b","text":"Share the array on writes"},{"id":"c","text":"Sort elements"},{"id":"d","text":"Filter elements"}],"correctAnswer":"a","explanation":"CopyOnWriteArrayList creates a new copy on each write.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/CopyOnWriteArrayList.html"},{"id":"java-266","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`BlockingQueue` supports blocking operations for producers and consumers.","options":[],"correctAnswer":true,"explanation":"BlockingQueue supports blocking put and take operations.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/BlockingQueue.html"},{"id":"java-267","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `ArrayBlockingQueue` use internally?","options":[{"id":"a","text":"A bounded array"},{"id":"b","text":"A linked list"},{"id":"c","text":"A hash table"},{"id":"d","text":"A tree"}],"correctAnswer":"a","explanation":"ArrayBlockingQueue uses a bounded array.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/ArrayBlockingQueue.html"},{"id":"java-268","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`LinkedBlockingQueue` is optionally bounded.","options":[],"correctAnswer":true,"explanation":"LinkedBlockingQueue can be bounded or unbounded.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/LinkedBlockingQueue.html"},{"id":"java-269","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `PriorityBlockingQueue` do?","options":[{"id":"a","text":"Provide a thread-safe priority queue"},{"id":"b","text":"Provide a LIFO queue"},{"id":"c","text":"Provide a FIFO queue only"},{"id":"d","text":"Provide a stack"}],"correctAnswer":"a","explanation":"PriorityBlockingQueue provides a thread-safe priority queue.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/PriorityBlockingQueue.html"},{"id":"java-270","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`DelayQueue` holds elements that become available after a delay.","options":[],"correctAnswer":true,"explanation":"DelayQueue holds elements until their delay expires.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/DelayQueue.html"},{"id":"java-271","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `SynchronousQueue` do?","options":[{"id":"a","text":"Hand off elements between threads without storage"},{"id":"b","text":"Store elements indefinitely"},{"id":"c","text":"Sort elements"},{"id":"d","text":"Filter elements"}],"correctAnswer":"a","explanation":"SynchronousQueue hands off elements between threads without storage.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/SynchronousQueue.html"},{"id":"java-272","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Exchanger` allows two threads to exchange objects.","options":[],"correctAnswer":true,"explanation":"Exchanger allows two threads to exchange objects.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Exchanger.html"},{"id":"java-273","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Phaser` do?","options":[{"id":"a","text":"Coordinate threads across multiple phases"},{"id":"b","text":"Count elements"},{"id":"c","text":"Manage locks"},{"id":"d","text":"Schedule tasks"}],"correctAnswer":"a","explanation":"Phaser coordinates threads across multiple phases.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Phaser.html"},{"id":"java-274","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`ForkJoinPool` is designed for divide-and-conquer tasks.","options":[],"correctAnswer":true,"explanation":"ForkJoinPool is designed for divide-and-conquer tasks.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/ForkJoinPool.html"},{"id":"java-275","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `RecursiveTask` return?","options":[{"id":"a","text":"A result"},{"id":"b","text":"Nothing"},{"id":"c","text":"A thread"},{"id":"d","text":"A lock"}],"correctAnswer":"a","explanation":"RecursiveTask returns a result.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/RecursiveTask.html"},{"id":"java-276","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`RecursiveAction` does not return a result.","options":[],"correctAnswer":true,"explanation":"RecursiveAction does not return a result.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/RecursiveAction.html"},{"id":"java-277","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.sleep(0)` do?","options":[{"id":"a","text":"Yield the CPU briefly"},{"id":"b","text":"Stop the thread"},{"id":"c","text":"Start the thread"},{"id":"d","text":"Join the thread"}],"correctAnswer":"a","explanation":"Thread.sleep(0) yields the CPU briefly.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-278","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.yield()` hints the scheduler to switch threads.","options":[],"correctAnswer":true,"explanation":"Thread.yield hints the scheduler to switch threads.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-279","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.setPriority()` do?","options":[{"id":"a","text":"Set the thread priority"},{"id":"b","text":"Set the thread name"},{"id":"c","text":"Set the thread as daemon"},{"id":"d","text":"Stop the thread"}],"correctAnswer":"a","explanation":"setPriority sets the thread priority.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-280","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.setDaemon(true)` must be called before the thread starts.","options":[],"correctAnswer":true,"explanation":"setDaemon must be called before start.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-281","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.setDefaultUncaughtExceptionHandler()` do?","options":[{"id":"a","text":"Set a default handler for uncaught exceptions"},{"id":"b","text":"Catch all exceptions"},{"id":"c","text":"Stop all threads"},{"id":"d","text":"Start all threads"}],"correctAnswer":"a","explanation":"setDefaultUncaughtExceptionHandler sets a default handler for uncaught exceptions.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-282","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.getAllStackTraces()` returns stack traces for all threads.","options":[],"correctAnswer":true,"explanation":"getAllStackTraces returns stack traces for all threads.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-283","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.dumpStack()` do?","options":[{"id":"a","text":"Print the current thread's stack trace"},{"id":"b","text":"Print all threads' stack traces"},{"id":"c","text":"Stop the thread"},{"id":"d","text":"Start the thread"}],"correctAnswer":"a","explanation":"dumpStack prints the current thread's stack trace.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-284","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.holdsLock(obj)` checks whether the current thread holds the monitor for obj.","options":[],"correctAnswer":true,"explanation":"holdsLock checks monitor ownership.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-285","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.onSpinWait()` do?","options":[{"id":"a","text":"Hint the CPU that the thread is spinning"},{"id":"b","text":"Stop the thread"},{"id":"c","text":"Start the thread"},{"id":"d","text":"Join the thread"}],"correctAnswer":"a","explanation":"onSpinWait hints the CPU that the thread is spinning.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-286","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.isInterrupted()` clears the interrupt status.","options":[],"correctAnswer":false,"explanation":"isInterrupted does not clear the status; interrupted() does.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-287","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.interrupted()` do?","options":[{"id":"a","text":"Check and clear the interrupt status"},{"id":"b","text":"Check without clearing"},{"id":"c","text":"Set the interrupt status"},{"id":"d","text":"Stop the thread"}],"correctAnswer":"a","explanation":"interrupted checks and clears the interrupt status.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-288","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.sleep()` can throw InterruptedException.","options":[],"correctAnswer":true,"explanation":"sleep can throw InterruptedException.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-289","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Object.notify()` do?","options":[{"id":"a","text":"Wake up one waiting thread on the object's monitor"},{"id":"b","text":"Wake up all waiting threads"},{"id":"c","text":"Stop the thread"},{"id":"d","text":"Start the thread"}],"correctAnswer":"a","explanation":"notify wakes up one waiting thread.","difficulty":"intermediate","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"java-290","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Object.notifyAll()` wakes up all waiting threads.","options":[],"correctAnswer":true,"explanation":"notifyAll wakes up all waiting threads.","difficulty":"beginner","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"java-291","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Object.wait()` require?","options":[{"id":"a","text":"Owning the object's monitor"},{"id":"b","text":"Nothing"},{"id":"c","text":"A lock on another object"},{"id":"d","text":"A static method"}],"correctAnswer":"a","explanation":"wait requires owning the object's monitor.","difficulty":"intermediate","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"java-292","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Object.wait(timeout)` waits up to the specified time.","options":[],"correctAnswer":true,"explanation":"wait(timeout) waits up to the specified time.","difficulty":"beginner","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"java-293","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `IllegalMonitorStateException` indicate?","options":[{"id":"a","text":"wait or notify called without owning the monitor"},{"id":"b","text":"A null pointer"},{"id":"c","text":"An array out of bounds"},{"id":"d","text":"A class cast issue"}],"correctAnswer":"a","explanation":"IllegalMonitorStateException indicates wait or notify was called without owning the monitor.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"java-294","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`InterruptedException` is a checked exception.","options":[],"correctAnswer":true,"explanation":"InterruptedException is checked.","difficulty":"beginner","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-11.html"},{"id":"java-295","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.interrupted()` vs `thread.isInterrupted()` differ in?","options":[{"id":"a","text":"interrupted() clears the status; isInterrupted() does not"},{"id":"b","text":"They are identical"},{"id":"c","text":"isInterrupted() clears the status"},{"id":"d","text":"interrupted() sets the status"}],"correctAnswer":"a","explanation":"interrupted() clears the status; isInterrupted() does not.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-296","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.sleep()` releases monitors held by the thread.","options":[],"correctAnswer":false,"explanation":"sleep does not release monitors.","difficulty":"intermediate","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"java-297","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Object.wait()` release?","options":[{"id":"a","text":"The monitor for the object"},{"id":"b","text":"All monitors"},{"id":"c","text":"Nothing"},{"id":"d","text":"The CPU only"}],"correctAnswer":"a","explanation":"wait releases the monitor for the object.","difficulty":"intermediate","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"java-298","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.yield()` guarantees a thread switch.","options":[],"correctAnswer":false,"explanation":"yield is only a hint, not a guarantee.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-299","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.isDaemon()` check?","options":[{"id":"a","text":"Whether the thread is a daemon"},{"id":"b","text":"Whether the thread is alive"},{"id":"c","text":"Whether the thread is interrupted"},{"id":"d","text":"Whether the thread is blocked"}],"correctAnswer":"a","explanation":"isDaemon checks whether the thread is a daemon.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-300","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.enumerate()` fills an array with references to all threads in the current thread's group.","options":[],"correctAnswer":true,"explanation":"enumerate fills an array with thread references.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"spring-251","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `WebClient` provide?","options":[{"id":"a","text":"A reactive HTTP client"},{"id":"b","text":"A synchronous HTTP client"},{"id":"c","text":"A database client"},{"id":"d","text":"A message broker client"}],"correctAnswer":"a","explanation":"WebClient is Spring's reactive HTTP client.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-252","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`WebClient` is part of Spring WebFlux.","options":[],"correctAnswer":true,"explanation":"WebClient is part of Spring WebFlux.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-253","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `WebClient.create()` do?","options":[{"id":"a","text":"Create a WebClient instance"},{"id":"b","text":"Create a RestTemplate"},{"id":"c","text":"Create a database connection"},{"id":"d","text":"Create a transaction"}],"correctAnswer":"a","explanation":"WebClient.create() creates a WebClient instance.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-254","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`WebClient.Builder` allows customization of the client.","options":[],"correctAnswer":true,"explanation":"WebClient.Builder allows customization.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-255","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `WebClient.get()` initiate?","options":[{"id":"a","text":"An HTTP GET request"},{"id":"b","text":"An HTTP POST request"},{"id":"c","text":"An HTTP PUT request"},{"id":"d","text":"An HTTP DELETE request"}],"correctAnswer":"a","explanation":"WebClient.get() initiates an HTTP GET request.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-256","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`WebClient.post()` initiates an HTTP POST request.","options":[],"correctAnswer":true,"explanation":"WebClient.post() initiates an HTTP POST request.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-257","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `WebClient.put()` initiate?","options":[{"id":"a","text":"An HTTP PUT request"},{"id":"b","text":"An HTTP GET request"},{"id":"c","text":"An HTTP POST request"},{"id":"d","text":"An HTTP DELETE request"}],"correctAnswer":"a","explanation":"WebClient.put() initiates an HTTP PUT request.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-258","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`WebClient.delete()` initiates an HTTP DELETE request.","options":[],"correctAnswer":true,"explanation":"WebClient.delete() initiates an HTTP DELETE request.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-259","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `WebClient.patch()` initiate?","options":[{"id":"a","text":"An HTTP PATCH request"},{"id":"b","text":"An HTTP GET request"},{"id":"c","text":"An HTTP POST request"},{"id":"d","text":"An HTTP PUT request"}],"correctAnswer":"a","explanation":"WebClient.patch() initiates an HTTP PATCH request.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webflux-webclient.html"},{"id":"spring-260","topicId":"spri