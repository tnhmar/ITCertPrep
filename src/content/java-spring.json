lass is on the classpath"},{"id":"d","text":"Whether a profile is active"}],"correctAnswer":"a","explanation":"ConditionalOnEnabledEndpoint evaluates whether an endpoint is enabled.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-304","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnExposedEndpoint` is the same as `@ConditionalOnEnabledEndpoint`.","options":[],"correctAnswer":false,"explanation":"Exposed checks exposure; Enabled checks the enabled flag.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-305","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnAvailableEndpoint` combine?","options":[{"id":"a","text":"Enabled and exposed checks"},{"id":"b","text":"Classpath and profile checks"},{"id":"c","text":"Bean and property checks"},{"id":"d","text":"Java version checks"}],"correctAnswer":"a","explanation":"ConditionalOnAvailableEndpoint combines enabled and exposed checks.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-306","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnAvailableEndpoint` can be used for health endpoints.","options":[],"correctAnswer":true,"explanation":"ConditionalOnAvailableEndpoint works for health endpoints too.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-307","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnEnabledEndpoint` evaluate?","options":[{"id":"a","text":"Whether an endpoint is enabled via configuration"},{"id":"b","text":"Whether an endpoint is exposed"},{"id":"c","text":"Whether a class is on the classpath"},{"id":"d","text":"Whether a profile is active"}],"correctAnswer":"a","explanation":"ConditionalOnEnabledEndpoint evaluates whether an endpoint is enabled.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-308","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnExposedEndpoint` is the same as `@ConditionalOnEnabledEndpoint`.","options":[],"correctAnswer":false,"explanation":"Exposed checks exposure; Enabled checks the enabled flag.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-309","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnAvailableEndpoint` combine?","options":[{"id":"a","text":"Enabled and exposed checks"},{"id":"b","text":"Classpath and profile checks"},{"id":"c","text":"Bean and property checks"},{"id":"d","text":"Java version checks"}],"correctAnswer":"a","explanation":"ConditionalOnAvailableEndpoint combines enabled and exposed checks.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-310","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnAvailableEndpoint` can be used for health endpoints.","options":[],"correctAnswer":true,"explanation":"ConditionalOnAvailableEndpoint works for health endpoints too.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-311","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Autowired` on a setter method do?","options":[{"id":"a","text":"Inject a dependency via the setter"},{"id":"b","text":"Declare a bean"},{"id":"c","text":"Map an endpoint"},{"id":"d","text":"Define a transaction"}],"correctAnswer":"a","explanation":"Autowired on a setter injects a dependency via the setter method.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-312","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Autowired` on a method injects dependencies via method parameters.","options":[],"correctAnswer":true,"explanation":"Autowired on a method injects dependencies via method parameters.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-313","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Autowired` on a constructor do?","options":[{"id":"a","text":"Inject dependencies via constructor parameters"},{"id":"b","text":"Declare a bean"},{"id":"c","text":"Map an endpoint"},{"id":"d","text":"Define a transaction"}],"correctAnswer":"a","explanation":"Autowired on a constructor injects dependencies via constructor parameters.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-314","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Autowired` can be omitted when a class has a single constructor.","options":[],"correctAnswer":true,"explanation":"Spring can use a single constructor without @Autowired.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-315","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Qualifier` on a constructor parameter do?","options":[{"id":"a","text":"Narrow the candidate bean for that parameter"},{"id":"b","text":"Change the bean scope"},{"id":"c","text":"Declare a bean"},{"id":"d","text":"Make the dependency optional"}],"correctAnswer":"a","explanation":"Qualifier on a constructor parameter narrows the candidate bean for that parameter.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-316","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Qualifier` can be used on fields, constructors, and methods.","options":[],"correctAnswer":true,"explanation":"Qualifier works on fields, constructors, and methods.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-317","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Primary` on a `@Bean` method do?","options":[{"id":"a","text":"Mark the bean as the preferred candidate"},{"id":"b","text":"Exclude the bean"},{"id":"c","text":"Change the scope"},{"id":"d","text":"Make the bean lazy"}],"correctAnswer":"a","explanation":"Primary marks the bean as the preferred candidate.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-318","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Primary` can be used on `@Component` classes too.","options":[],"correctAnswer":true,"explanation":"Primary works on component classes as well.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-319","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Lazy` on a `@Component` class do?","options":[{"id":"a","text":"Defer initialization until needed"},{"id":"b","text":"Make the bean eager"},{"id":"c","text":"Change the scope"},{"id":"d","text":"Exclude the bean"}],"correctAnswer":"a","explanation":"Lazy on a component defers initialization.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/dependencies/factory-lazy-init.html"},{"id":"spring-320","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Lazy` can be combined with `@Autowired` on an injection point.","options":[],"correctAnswer":true,"explanation":"Lazy can be combined with Autowired for lazy resolution.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/core/beans/dependencies/factory-lazy-init.html"},{"id":"spring-321","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@ConfigurationProperties` with `ignoreUnknownFields = true` do?","options":[{"id":"a","text":"Ignore properties that do not match a field"},{"id":"b","text":"Fail on unknown properties"},{"id":"c","text":"Ignore all properties"},{"id":"d","text":"Bind only known properties"}],"correctAnswer":"a","explanation":"ignoreUnknownFields = true ignores properties without a matching field.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-322","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` supports nested objects.","options":[],"correctAnswer":true,"explanation":"ConfigurationProperties supports nested objects for structured configuration.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-323","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@ConfigurationProperties` with `ignoreInvalidFields = true` do?","options":[{"id":"a","text":"Ignore fields that cannot be bound"},{"id":"b","text":"Fail on invalid fields"},{"id":"c","text":"Ignore all fields"},{"id":"d","text":"Bind only valid fields"}],"correctAnswer":"a","explanation":"ignoreInvalidFields = true ignores fields that cannot be bound.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-324","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` supports validation through JSR-303 annotations.","options":[],"correctAnswer":true,"explanation":"ConfigurationProperties supports JSR-303 validation.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-325","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@Validated` on a `@ConfigurationProperties` class do?","options":[{"id":"a","text":"Enable validation for the bound properties"},{"id":"b","text":"Disable validation"},{"id":"c","text":"Change the prefix"},{"id":"d","text":"Ignore unknown fields"}],"correctAnswer":"a","explanation":"Validated enables JSR-303 validation for the bound properties.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-326","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` can be registered via `@EnableConfigurationProperties` or `@ConfigurationPropertiesScan`.","options":[],"correctAnswer":true,"explanation":"Both mechanisms register configuration-properties classes.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-327","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@ConfigurationPropertiesScan` do?","options":[{"id":"a","text":"Scan for configuration-properties classes automatically"},{"id":"b","text":"Scan for components"},{"id":"c","text":"Scan for endpoints"},{"id":"d","text":"Scan for entities"}],"correctAnswer":"a","explanation":