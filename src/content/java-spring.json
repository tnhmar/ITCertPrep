ty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-303","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `Math.floor(2.7)` return?","options":[{"id":"a","text":"2.0"},{"id":"b","text":"3.0"},{"id":"c","text":"2"},{"id":"d","text":"2.7"}],"correctAnswer":"a","explanation":"Math.floor returns the largest double less than or equal to the argument.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-304","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`Math.ceil(2.1)` returns 3.0.","options":[],"correctAnswer":true,"explanation":"Math.ceil returns the smallest double greater than or equal to the argument.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-305","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `Math.pow(2, 3)` return?","options":[{"id":"a","text":"8.0"},{"id":"b","text":"6.0"},{"id":"c","text":"9.0"},{"id":"d","text":"5.0"}],"correctAnswer":"a","explanation":"Math.pow(2, 3) returns 8.0.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-306","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`Math.sqrt(16)` returns 4.0.","options":[],"correctAnswer":true,"explanation":"Math.sqrt(16) returns 4.0.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-307","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `Math.min(3, 7)` return?","options":[{"id":"a","text":"3"},{"id":"b","text":"7"},{"id":"c","text":"10"},{"id":"d","text":"4"}],"correctAnswer":"a","explanation":"Math.min returns the smaller of its two arguments.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-308","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`Math.random()` returns a double between 0.0 and 1.0.","options":[],"correctAnswer":true,"explanation":"Math.random returns a double between 0.0 and 1.0.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-309","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `Math.round(2.4)` return?","options":[{"id":"a","text":"2"},{"id":"b","text":"3"},{"id":"c","text":"2.4"},{"id":"d","text":"2.5"}],"correctAnswer":"a","explanation":"Math.round(2.4) returns 2.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-310","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`Math.max(2, 2)` returns 2.","options":[],"correctAnswer":true,"explanation":"Math.max(2, 2) returns 2.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Math.html"},{"id":"java-311","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `Integer.parseInt(\"123\")` return?","options":[{"id":"a","text":"123"},{"id":"b","text":"\"123\""},{"id":"c","text":"null"},{"id":"d","text":"0"}],"correctAnswer":"a","explanation":"Integer.parseInt converts a String to an int.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Integer.html"},{"id":"java-312","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`Integer.valueOf(\"123\")` returns an Integer object.","options":[],"correctAnswer":true,"explanation":"Integer.valueOf returns an Integer object.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Integer.html"},{"id":"java-313","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `Double.parseDouble(\"2.5\")` return?","options":[{"id":"a","text":"2.5"},{"id":"b","text":"\"2.5\""},{"id":"c","text":"2"},{"id":"d","text":"0"}],"correctAnswer":"a","explanation":"Double.parseDouble converts a String to a double.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Double.html"},{"id":"java-314","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`Boolean.parseBoolean(\"true\")` returns true.","options":[],"correctAnswer":true,"explanation":"Boolean.parseBoolean converts a String to a boolean.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Boolean.html"},{"id":"java-315","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `String.valueOf(true)` return?","options":[{"id":"a","text":"\"true\""},{"id":"b","text":"true"},{"id":"c","text":"null"},{"id":"d","text":"\"True\""}],"correctAnswer":"a","explanation":"String.valueOf converts its argument to its String representation.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-316","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.isEmpty()` returns true for an empty String.","options":[],"correctAnswer":true,"explanation":"isEmpty returns true for an empty String.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-317","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.isBlank()` return for a String with only spaces?","options":[{"id":"a","text":"true"},{"id":"b","text":"false"},{"id":"c","text":"null"},{"id":"d","text":"0"}],"correctAnswer":"a","explanation":"isBlank returns true for a String with only whitespace.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-318","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.contains(\"ell\")` returns true for \"hello\".","options":[],"correctAnswer":true,"explanation":"contains checks if the String contains the sequence.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-319","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.indexOf(\"l\")` return for \"hello\"?","options":[{"id":"a","text":"2"},{"id":"b","text":"3"},{"id":"c","text":"1"},{"id":"d","text":"-1"}],"correctAnswer":"a","explanation":"indexOf returns the first occurrence index.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-320","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.replace('l', 'L')` returns a new String.","options":[],"correctAnswer":true,"explanation":"replace returns a new String.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-321","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.substring(1, 3)` return for \"hello\"?","options":[{"id":"a","text":"\"el\""},{"id":"b","text":"\"ell\""},{"id":"c","text":"\"he\""},{"id":"d","text":"\"lo\""}],"correctAnswer":"a","explanation":"substring(1, 3) returns characters from index 1 to 2.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-322","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.trim()` removes leading and trailing whitespace.","options":[],"correctAnswer":true,"explanation":"trim removes leading and trailing whitespace.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-323","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.split(\"\")` return for \"abc\"?","options":[{"id":"a","text":"An array of characters"},{"id":"b","text":"A String"},{"id":"c","text":"A list"},{"id":"d","text":"A map"}],"correctAnswer":"a","explanation":"split returns an array of substrings.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-324","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.equals(\"Hello\")` is case-sensitive.","options":[],"correctAnswer":true,"explanation":"equals is case-sensitive.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-325","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.equalsIgnoreCase(\"HELLO\")` return for \"hello\"?","options":[{"id":"a","text":"true"},{"id":"b","text":"false"},{"id":"c","text":"null"},{"id":"d","text":"0"}],"correctAnswer":"a","explanation":"equalsIgnoreCase ignores case.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-326","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.startsWith(\"he\")` returns true for \"hello\".","options":[],"correctAnswer":true,"explanation":"startsWith checks the prefix.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-327","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.endsWith(\"lo\")` return for \"hello\"?","options":[{"id":"a","text":"true"},{"id":"b","text":"false"},{"id":"c","text":"null"},{"id":"d","text":"0"}],"correctAnswer":"a","explanation":"endsWith checks the suffix.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-328","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.concat(\" world\")` returns a new String.","options":[],"correctAnswer":true,"explanation":"concat returns a new String.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-329","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.repeat(2)` return for \"ab\"?","options":[{"id":"a","text":"\"abab\""},{"id":"b","text":"\"ab\""},{"id":"c","text":"\"aabb\""},{"id":"d","text":"\"ba\""}],"correctAnswer":"a","explanation":"repeat returns the String repeated n times.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-330","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars()` returns an IntStream.","options":[],"correctAnswer":true,"explanation":"chars returns an IntStream.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-331","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().count()` return for \"hello\"?","options":[{"id":"a","text":"5"},{"id":"b","text":"4"},{"id":"c","text":"6"},{"id":"d","text":"0"}],"correctAnswer":"a","explanation":"chars().count() returns the number of characters.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-332","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().filter(c -> c == 'l').count()` returns 2 for \"hello\".","options":[],"correctAnswer":true,"explanation":"filter and count return the number of matching characters.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-333","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().mapToObj(c -> (char) c).collect(Collectors.toList())` return?","options":[{"id":"a","text":"A list of characters"},{"id":"b","text":"A String"},{"id":"c","text":"An int"},{"id":"d","text":"A map"}],"correctAnswer":"a","explanation":"It returns a list of characters.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-334","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().distinct().count()` returns the number of unique characters.","options":[],"correctAnswer":true,"explanation":"distinct and count return the number of unique characters.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-335","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().sorted().mapToObj(c -> (char) c).map(String::valueOf).collect(Collectors.joining())` return for \"cba\"?","options":[{"id":"a","text":"\"abc\""},{"id":"b","text":"\"cba\""},{"id":"c","text":"\"abcabc\""},{"id":"d","text":"\"cba\""}],"correctAnswer":"a","explanation":"It sorts characters and joins them.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-336","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().boxed().collect(Collectors.toList())` returns a list of Integers.","options":[],"correctAnswer":true,"explanation":"boxed returns a Stream of Integer.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-337","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().map(c -> c + 1).mapToObj(c -> (char) c).map(String::valueOf).collect(Collectors.joining())` return for \"abc\"?","options":[{"id":"a","text":"\"bcd\""},{"id":"b","text":"\"abc\""},{"id":"c","text":"\"abd\""},{"id":"d","text":"\"acd\""}],"correctAnswer":"a","explanation":"It increments each character by 1.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-338","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().filter(c -> c != 'l').mapToObj(c -> (char) c).map(String::valueOf).collect(Collectors.joining())` returns \"heo\" for \"hello\".","options":[],"correctAnswer":true,"explanation":"It filters out 'l' characters.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-339","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().map(c -> Character.toUpperCase(c)).mapToObj(c -> (char) c).map(String::valueOf).collect(Collectors.joining())` return for \"hello\"?","options":[{"id":"a","text":"\"HELLO\""},{"id":"b","text":"\"hello\""},{"id":"c","text":"\"Hello\""},{"id":"d","text":"\"hellO\""}],"correctAnswer":"a","explanation":"It converts to upper case.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-340","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().map(c -> c - 1).mapToObj(c -> (char) c).map(String::valueOf).collect(Collectors.joining())` returns \"gdkkn\" for \"hello\".","options":[],"correctAnswer":true,"explanation":"It decrements each character by 1.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-341","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().filter(c -> c % 2 == 0).count()` return for \"abcdef\"?","options":[{"id":"a","text":"3"},{"id":"b","text":"2"},{"id":"c","text":"4"},{"id":"d","text":"1"}],"correctAnswer":"a","explanation":"It counts characters with even char codes.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-342","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().map(c -> c * 2).sum()` returns the sum of doubled char codes.","options":[],"correctAnswer":true,"explanation":"It doubles each char code and sums.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-343","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().map(c -> c - 'a' + 1).sum()` return for \"abc\"?","options":[{"id":"a","text":"6"},{"id":"b","text":"3"},{"id":"c","text":"9"},{"id":"d","text":"12"}],"correctAnswer":"a","explanation":"It maps a=1, b=2, c=3 and sums to 6.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-344","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().map(c -> c - 'a' + 1).max()` returns the highest mapped value.","options":[],"correctAnswer":true,"explanation":"max returns the highest mapped value.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-345","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().map(c -> c - 'a' + 1).sum()` return for \"hello\"?","options":[{"id":"a","text":"52"},{"id":"b","text":"50"},{"id":"c","text":"54"},{"id":"d","text":"56"}],"correctAnswer":"a","explanation":"It maps and sums the values.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-346","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().map(c -> c - 'a' + 1).average()` returns an OptionalDouble.","options":[],"correctAnswer":true,"explanation":"average returns an OptionalDouble.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-347","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().map(c -> c - 'a' + 1).boxed().collect(Collectors.toList())` return?","options":[{"id":"a","text":"A list of Integers"},{"id":"b","text":"A String"},{"id":"c","text":"An int"},{"id":"d","text":"A map"}],"correctAnswer":"a","explanation":"It returns a list of Integers.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-348","topicId":"core-java","sectionId":"language-basics","type":"true-false","prompt":"`str.chars().map(c -> c - 'a' + 1).boxed().collect(Collectors.summingInt(Integer::intValue))` returns the sum.","options":[],"correctAnswer":true,"explanation":"It sums the mapped values.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/String.html"},{"id":"java-349","topicId":"core-java","sectionId":"language-basics","type":"single-choice","prompt":"What does `str.chars().map(c -> c - 'a' + 1).boxed().collect(Collectors.averagingInt(Integer::intValue))` return?","options":[{"id":"a","text":"The average as a Double"}