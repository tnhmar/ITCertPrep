{"schemaVersion":1,"category":{"id":"java-spring","title":"Java & Spring","contentVersion":3},"topics":[{"id":"core-java","title":"Core Java","sections":[{"id":"language-basics","title":"Language Basics"},{"id":"oop-types","title":"Classes, Interfaces and Records"},{"id":"generics","title":"Generics and Type System"},{"id":"exceptions","title":"Exceptions"},{"id":"collections","title":"Collections and Streams"},{"id":"concurrency","title":"Concurrency and Memory Model"},{"id":"modules","title":"Packages and Modules"}]},{"id":"spring-boot","title":"Spring Boot","sections":[{"id":"auto-configuration","title":"Auto-configuration"},{"id":"dependency-injection","title":"Dependency Injection"},{"id":"configuration","title":"Externalized Configuration and Profiles"},{"id":"web","title":"Web and REST"},{"id":"data","title":"Data and Transactions"},{"id":"testing","title":"Testing"},{"id":"actuator","title":"Actuator and Operations"}]},{"id":"spring-security","title":"Spring Security","sections":[{"id":"security-fundamentals","title":"Security Fundamentals"}]},{"id":"spring-core","title":"Spring Core","sections":[{"id":"ioc-container","title":"IoC Container and Beans"},{"id":"aop-events","title":"AOP and Events"}]},{"id":"spring-data","title":"Spring Data","sections":[{"id":"repositories","title":"Repositories and Data Access"}]}],"questions":[{"id":"java-201","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `ArrayList` use internally?","options":[{"id":"a","text":"A resizable array"},{"id":"b","text":"A linked list"},{"id":"c","text":"A hash table"},{"id":"d","text":"A tree"}],"correctAnswer":"a","explanation":"ArrayList is backed by a resizable array.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/ArrayList.html"},{"id":"java-202","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`LinkedList` implements both List and Deque.","options":[],"correctAnswer":true,"explanation":"LinkedList implements List and Deque.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/LinkedList.html"},{"id":"java-203","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `HashSet` use internally?","options":[{"id":"a","text":"A hash table"},{"id":"b","text":"A tree"},{"id":"c","text":"An array"},{"id":"d","text":"A linked list"}],"correctAnswer":"a","explanation":"HashSet is backed by a hash table (HashMap).","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/HashSet.html"},{"id":"java-204","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`TreeSet` maintains elements in sorted order.","options":[],"correctAnswer":true,"explanation":"TreeSet maintains elements in sorted order using a red-black tree.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/TreeSet.html"},{"id":"java-205","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `LinkedHashMap` maintain?","options":[{"id":"a","text":"Insertion order"},{"id":"b","text":"Sorted key order"},{"id":"c","text":"No order"},{"id":"d","text":"Random order"}],"correctAnswer":"a","explanation":"LinkedHashMap maintains insertion order.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/LinkedHashMap.html"},{"id":"java-206","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`ArrayDeque` is a resizable-array implementation of Deque.","options":[],"correctAnswer":true,"explanation":"ArrayDeque is a resizable-array implementation of Deque.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/ArrayDeque.html"},{"id":"java-207","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `Collections.sort()` require for objects?","options":[{"id":"a","text":"The objects must implement Comparable or a Comparator must be provided"},{"id":"b","text":"The objects must be Strings"},{"id":"c","text":"The objects must be primitives"},{"id":"d","text":"No requirement"}],"correctAnswer":"a","explanation":"Sorting requires Comparable or a Comparator.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/Collections.html"},{"id":"java-208","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`Stream.of()` creates a stream from values.","options":[],"correctAnswer":true,"explanation":"Stream.of creates a stream from the given values.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-209","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `stream.distinct()` do?","options":[{"id":"a","text":"Remove duplicate elements"},{"id":"b","text":"Sort elements"},{"id":"c","text":"Filter elements"},{"id":"d","text":"Map elements"}],"correctAnswer":"a","explanation":"distinct removes duplicates based on equals.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-210","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`stream.sorted()` sorts elements in natural order or by a Comparator.","options":[],"correctAnswer":true,"explanation":"sorted sorts elements in natural order or by a provided Comparator.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-211","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `stream.limit(n)` do?","options":[{"id":"a","text":"Truncate the stream to at most n elements"},{"id":"b","text":"Skip n elements"},{"id":"c","text":"Sort n elements"},{"id":"d","text":"Filter n elements"}],"correctAnswer":"a","explanation":"limit truncates the stream to at most n elements.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-212","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`stream.skip(n)` skips the first n elements.","options":[],"correctAnswer":true,"explanation":"skip discards the first n elements.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-213","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `stream.reduce()` do?","options":[{"id":"a","text":"Combine elements into a single result"},{"id":"b","text":"Filter elements"},{"id":"c","text":"Sort elements"},{"id":"d","text":"Map elements"}],"correctAnswer":"a","explanation":"reduce combines elements into a single result using an associative function.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-214","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`stream.flatMap()` flattens nested structures into one stream.","options":[],"correctAnswer":true,"explanation":"flatMap flattens nested streams into one stream.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-215","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `stream.anyMatch()` return?","options":[{"id":"a","text":"true if any element matches the predicate"},{"id":"b","text":"true if all elements match"},{"id":"c","text":"The first matching element"},{"id":"d","text":"A list of matches"}],"correctAnswer":"a","explanation":"anyMatch returns true if at least one element matches.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-216","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`stream.allMatch()` returns true only if all elements match.","options":[],"correctAnswer":true,"explanation":"allMatch returns true only when every element matches.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-217","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `stream.noneMatch()` return?","options":[{"id":"a","text":"true if no element matches"},{"id":"b","text":"true if any element matches"},{"id":"c","text":"true if all match"},{"id":"d","text":"A list"}],"correctAnswer":"a","explanation":"noneMatch returns true when no element matches.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-218","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`stream.findFirst()` returns an Optional with the first element.","options":[],"correctAnswer":true,"explanation":"findFirst returns an Optional describing the first element.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-219","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `stream.count()` return?","options":[{"id":"a","text":"The number of elements"},{"id":"b","text":"The first element"},{"id":"c","text":"A list"},{"id":"d","text":"A map"}],"correctAnswer":"a","explanation":"count returns the number of elements in the stream.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-220","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`Collectors.toList()` collects a stream into a List.","options":[],"correctAnswer":true,"explanation":"toList collects elements into a List.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-221","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `Collectors.joining()` do?","options":[{"id":"a","text":"Concatenate stream elements into a String"},{"id":"b","text":"Group elements"},{"id":"c","text":"Sort elements"},{"id":"d","text":"Count elements"}],"correctAnswer":"a","explanation":"joining concatenates elements into a single String.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-222","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`Collectors.counting()` counts elements in a stream.","options":[],"correctAnswer":true,"explanation":"counting counts the number of elements.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-223","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `Collectors.averagingInt()` compute?","options":[{"id":"a","text":"The average of int values"},{"id":"b","text":"The sum"},{"id":"c","text":"The max"},{"id":"d","text":"The count"}],"correctAnswer":"a","explanation":"averagingInt computes the arithmetic mean of int values.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-224","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`Collectors.summingInt()` computes the sum of int values.","options":[],"correctAnswer":true,"explanation":"summingInt computes the sum.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-225","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `Collectors.maxBy()` return?","options":[{"id":"a","text":"An Optional with the maximum element"},{"id":"b","text":"The minimum element"},{"id":"c","text":"A list"},{"id":"d","text":"A count"}],"correctAnswer":"a","explanation":"maxBy returns an Optional with the maximum element per a Comparator.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-226","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`Collectors.partitioningBy()` splits elements into two groups based on a predicate.","options":[],"correctAnswer":true,"explanation":"partitioningBy splits into true/false groups.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-227","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `Collectors.toMap()` do?","options":[{"id":"a","text":"Collect a stream into a Map"},{"id":"b","text":"Collect into a List"},{"id":"c","text":"Collect into a Set"},{"id":"d","text":"Count elements"}],"correctAnswer":"a","explanation":"toMap collects elements into a Map using key and value functions.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-228","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`Collectors.toSet()` collects a stream into a Set.","options":[],"correctAnswer":true,"explanation":"toSet collects into a Set.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Collectors.html"},{"id":"java-229","topicId":"core-java","sectionId":"collections","type":"single-choice","prompt":"What does `stream.peek()` do?","options":[{"id":"a","text":"Perform an action on each element without changing the stream"},{"id":"b","text":"Filter elements"},{"id":"c","text":"Sort elements"},{"id":"d","text":"Count elements"}],"correctAnswer":"a","explanation":"peek performs an action on each element, mainly for debugging.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-230","topicId":"core-java","sectionId":"collections","type":"true-false","prompt":"`stream.iterator()` returns an Iterator for the stream.","options":[],"correctAnswer":true,"explanation":"iterator returns an Iterator for traversing the stream.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/stream/Stream.html"},{"id":"java-231","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.start()` do?","options":[{"id":"a","text":"Begin executing the thread's run method"},{"id":"b","text":"Pause the thread"},{"id":"c","text":"Stop the thread"},{"id":"d","text":"Join the thread"}],"correctAnswer":"a","explanation":"start begins execution of the thread's run method.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-232","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"Calling `run()` directly on a Thread executes it in the current thread.","options":[],"correctAnswer":true,"explanation":"Calling run directly executes in the current thread, not a new one.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-233","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `thread.join()` do?","options":[{"id":"a","text":"Wait for the thread to finish"},{"id":"b","text":"Start the thread"},{"id":"c","text":"Stop the thread"},{"id":"d","text":"Pause the thread"}],"correctAnswer":"a","explanation":"join waits for the thread to complete.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-234","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Thread.interrupt()` sets the interrupt status of a thread.","options":[],"correctAnswer":true,"explanation":"interrupt sets the interrupt status.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-235","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Thread.isAlive()` return?","options":[{"id":"a","text":"Whether the thread has started and not yet terminated"},{"id":"b","text":"Whether the thread is paused"},{"id":"c","text":"Whether the thread is a daemon"},{"id":"d","text":"Whether the thread is blocked"}],"correctAnswer":"a","explanation":"isAlive returns true if the thread has started and not terminated.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-236","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"A daemon thread does not prevent the JVM from exiting.","options":[],"correctAnswer":true,"explanation":"Daemon threads do not prevent JVM exit.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/Thread.html"},{"id":"java-237","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `synchronized` on a block do?","options":[{"id":"a","text":"Acquire a monitor lock on the specified object"},{"id":"b","text":"Make a method static"},{"id":"c","text":"Declare a variable"},{"id":"d","text":"Import a package"}],"correctAnswer":"a","explanation":"synchronized block acquires the monitor lock on the specified object.","difficulty":"intermediate","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-14.html"},{"id":"java-238","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`ReentrantLock` allows a thread to reacquire a lock it already holds.","options":[],"correctAnswer":true,"explanation":"ReentrantLock is reentrant.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/locks/ReentrantLock.html"},{"id":"java-239","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `CountDownLatch` do?","options":[{"id":"a","text":"Allow threads to wait until a count reaches zero"},{"id":"b","text":"Count elements in a collection"},{"id":"c","text":"Manage database connections"},{"id":"d","text":"Schedule tasks"}],"correctAnswer":"a","explanation":"CountDownLatch lets threads wait until the count reaches zero.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/CountDownLatch.html"},{"id":"java-240","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Semaphore` controls access to a resource through permits.","options":[],"correctAnswer":true,"explanation":"Semaphore controls access via permits.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Semaphore.html"},{"id":"java-241","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `CyclicBarrier` do?","options":[{"id":"a","text":"Allow threads to wait for each other at a barrier point"},{"id":"b","text":"Count elements"},{"id":"c","text":"Manage locks"},{"id":"d","text":"Schedule tasks"}],"correctAnswer":"a","explanation":"CyclicBarrier lets threads wait for each other at a barrier.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/CyclicBarrier.html"},{"id":"java-242","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`CompletableFuture` supports asynchronous computation with chaining.","options":[],"correctAnswer":true,"explanation":"CompletableFuture supports async computation and chaining.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/CompletableFuture.html"},{"id":"java-243","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Executors.newFixedThreadPool(n)` create?","options":[{"id":"a","text":"A thread pool with n threads"},{"id":"b","text":"A single thread"},{"id":"c","text":"A scheduled pool"},{"id":"d","text":"A cached pool"}],"correctAnswer":"a","explanation":"newFixedThreadPool creates a pool with n threads.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Executors.html"},{"id":"java-244","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Executors.newSingleThreadExecutor()` creates a pool with one thread.","options":[],"correctAnswer":true,"explanation":"newSingleThreadExecutor creates a pool with one thread.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Executors.html"},{"id":"java-245","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Executors.newCachedThreadPool()` do?","options":[{"id":"a","text":"Create a pool that reuses threads as needed"},{"id":"b","text":"Create a fixed pool"},{"id":"c","text":"Create a scheduled pool"},{"id":"d","text":"Create a single thread"}],"correctAnswer":"a","explanation":"newCachedThreadPool reuses threads as needed.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Executors.html"},{"id":"java-246","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Executors.newScheduledThreadPool(n)` supports delayed and periodic tasks.","options":[],"correctAnswer":true,"explanation":"newScheduledThreadPool supports delayed and periodic tasks.","difficulty":"intermediate","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Executors.html"},{"id":"java-247","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `Future.get()` do?","options":[{"id":"a","text":"Wait for the computation to complete and retrieve the result"},{"id":"b","text":"Cancel the computation"},{"id":"c","text":"Start the computation"},{"id":"d","text":"Check if done"}],"correctAnswer":"a","explanation":"get waits for completion and returns the result.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Future.html"},{"id":"java-248","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`Future.cancel()` attempts to cancel the computation.","options":[],"correctAnswer":true,"explanation":"cancel attempts to cancel the task.","difficulty":"beginner","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/util/concurrent/Future.html"},{"id":"java-249","topicId":"core-java","sectionId":"concurrency","type":"single-choice","prompt":"What does `ThreadLocal` provide?","options":[{"id":"a","text":"Per-thread variable storage"},{"id":"b","text":"Shared variable storage"},{"id":"c","text":"A lock"},{"id":"d","text":"A queue"}],"correctAnswer":"a","explanation":"ThreadLocal provides per-thread isolated variable storage.","difficulty":"advanced","source":"https://docs.oracle.com/en/java/javase/22/docs/api/java.base/java/lang/ThreadLocal.html"},{"id":"java-250","topicId":"core-java","sectionId":"concurrency","type":"true-false","prompt":"`volatile` guarantees atomicity of compound operations.","options":[],"correctAnswer":false,"explanation":"volatile guarantees visibility and ordering, not atomicity of compound operations.","difficulty":"advanced","source":"https://docs.oracle.com/javase/specs/jls/se22/html/jls-17.html"},{"id":"spring-201","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnAvailableEndpoint` check?","options":[{"id":"a","text":"Whether an Actuator endpoint is available"},{"id":"b","text":"Whether a class is on the classpath"},{"id":"c","text":"Whether a profile is active"},{"id":"d","text":"Whether a bean exists"}],"correctAnswer":"a","explanation":"ConditionalOnAvailableEndpoint checks whether an Actuator endpoint is available.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-202","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnEnabledEndpoint` checks whether an endpoint is enabled.","options":[],"correctAnswer":true,"explanation":"ConditionalOnEnabledEndpoint checks whether an endpoint is enabled.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-203","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnExposedEndpoint` check?","options":[{"id":"a","text":"Whether an endpoint is exposed"},{"id":"b","text":"Whether an endpoint is enabled"},{"id":"c","text":"Whether a class is on the classpath"},{"id":"d","text":"Whether a profile is active"}],"correctAnswer":"a","explanation":"ConditionalOnExposedEndpoint checks whether an endpoint is exposed.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-204","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnAvailableEndpoint` is specific to Spring Boot Actuator.","options":[],"correctAnswer":true,"explanation":"ConditionalOnAvailableEndpoint is Actuator-specific.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-205","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnEnabledInfoContributor` check?","options":[{"id":"a","text":"Whether an info contributor is enabled"},{"id":"b","text":"Whether an endpoint is exposed"},{"id":"c","text":"Whether a class is on the classpath"},{"id":"d","text":"Whether a profile is active"}],"correctAnswer":"a","explanation":"ConditionalOnEnabledInfoContributor checks whether an info contributor is enabled.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-206","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnAvailableEndpoint` can be used for custom endpoints.","options":[],"correctAnswer":true,"explanation":"ConditionalOnAvailableEndpoint works for custom endpoints too.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-207","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnEnabledEndpoint` evaluate?","options":[{"id":"a","text":"Whether an endpoint is enabled via configuration"},{"id":"b","text":"Whether an endpoint is exposed"},{"id":"c","text":"Whether a class is on the classpath"},{"id":"d","text":"Whether a profile is active"}],"correctAnswer":"a","explanation":"ConditionalOnEnabledEndpoint evaluates whether an endpoint is enabled.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-208","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnExposedEndpoint` is the same as `@ConditionalOnEnabledEndpoint`.","options":[],"correctAnswer":false,"explanation":"Exposed checks exposure; Enabled checks the enabled flag.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-209","topicId":"spring-boot","sectionId":"auto-configuration","type":"single-choice","prompt":"What does `@ConditionalOnAvailableEndpoint` combine?","options":[{"id":"a","text":"Enabled and exposed checks"},{"id":"b","text":"Classpath and profile checks"},{"id":"c","text":"Bean and property checks"},{"id":"d","text":"Java version checks"}],"correctAnswer":"a","explanation":"ConditionalOnAvailableEndpoint combines enabled and exposed checks.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-210","topicId":"spring-boot","sectionId":"auto-configuration","type":"true-false","prompt":"`@ConditionalOnAvailableEndpoint` can be used for health endpoints.","options":[],"correctAnswer":true,"explanation":"ConditionalOnAvailableEndpoint works for health endpoints too.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/actuator/endpoints.html"},{"id":"spring-211","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Autowired` on a setter method do?","options":[{"id":"a","text":"Inject a dependency via the setter"},{"id":"b","text":"Declare a bean"},{"id":"c","text":"Map an endpoint"},{"id":"d","text":"Define a transaction"}],"correctAnswer":"a","explanation":"Autowired on a setter injects a dependency via the setter method.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-212","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Autowired` on a method injects dependencies via method parameters.","options":[],"correctAnswer":true,"explanation":"Autowired on a method injects dependencies via method parameters.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-213","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Autowired` on a constructor do?","options":[{"id":"a","text":"Inject dependencies via constructor parameters"},{"id":"b","text":"Declare a bean"},{"id":"c","text":"Map an endpoint"},{"id":"d","text":"Define a transaction"}],"correctAnswer":"a","explanation":"Autowired on a constructor injects dependencies via constructor parameters.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-214","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Autowired` can be omitted when a class has a single constructor.","options":[],"correctAnswer":true,"explanation":"Spring can use a single constructor without @Autowired.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired.html"},{"id":"spring-215","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Qualifier` on a constructor parameter do?","options":[{"id":"a","text":"Narrow the candidate bean for that parameter"},{"id":"b","text":"Change the bean scope"},{"id":"c","text":"Declare a bean"},{"id":"d","text":"Make the dependency optional"}],"correctAnswer":"a","explanation":"Qualifier on a constructor parameter narrows the candidate bean for that parameter.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-216","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Qualifier` can be used on fields, constructors, and methods.","options":[],"correctAnswer":true,"explanation":"Qualifier works on fields, constructors, and methods.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-217","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Primary` on a `@Bean` method do?","options":[{"id":"a","text":"Mark the bean as the preferred candidate"},{"id":"b","text":"Exclude the bean"},{"id":"c","text":"Change the scope"},{"id":"d","text":"Make the bean lazy"}],"correctAnswer":"a","explanation":"Primary marks the bean as the preferred candidate.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-218","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Primary` can be used on `@Component` classes too.","options":[],"correctAnswer":true,"explanation":"Primary works on component classes as well.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/core/beans/annotation-config/autowired-qualifiers.html"},{"id":"spring-219","topicId":"spring-boot","sectionId":"dependency-injection","type":"single-choice","prompt":"What does `@Lazy` on a `@Component` class do?","options":[{"id":"a","text":"Defer initialization until needed"},{"id":"b","text":"Make the bean eager"},{"id":"c","text":"Change the scope"},{"id":"d","text":"Exclude the bean"}],"correctAnswer":"a","explanation":"Lazy on a component defers initialization.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/core/beans/dependencies/factory-lazy-init.html"},{"id":"spring-220","topicId":"spring-boot","sectionId":"dependency-injection","type":"true-false","prompt":"`@Lazy` can be combined with `@Autowired` on an injection point.","options":[],"correctAnswer":true,"explanation":"Lazy can be combined with Autowired for lazy resolution.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/core/beans/dependencies/factory-lazy-init.html"},{"id":"spring-221","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@ConfigurationProperties` with `ignoreUnknownFields = true` do?","options":[{"id":"a","text":"Ignore properties that do not match a field"},{"id":"b","text":"Fail on unknown properties"},{"id":"c","text":"Ignore all properties"},{"id":"d","text":"Bind only known properties"}],"correctAnswer":"a","explanation":"ignoreUnknownFields = true ignores properties without a matching field.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-222","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` supports nested objects.","options":[],"correctAnswer":true,"explanation":"ConfigurationProperties supports nested objects for structured configuration.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-223","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@ConfigurationProperties` with `ignoreInvalidFields = true` do?","options":[{"id":"a","text":"Ignore fields that cannot be bound"},{"id":"b","text":"Fail on invalid fields"},{"id":"c","text":"Ignore all fields"},{"id":"d","text":"Bind only valid fields"}],"correctAnswer":"a","explanation":"ignoreInvalidFields = true ignores fields that cannot be bound.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-224","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` supports validation through JSR-303 annotations.","options":[],"correctAnswer":true,"explanation":"ConfigurationProperties supports JSR-303 validation.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-225","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@Validated` on a `@ConfigurationProperties` class do?","options":[{"id":"a","text":"Enable validation for the bound properties"},{"id":"b","text":"Disable validation"},{"id":"c","text":"Change the prefix"},{"id":"d","text":"Ignore unknown fields"}],"correctAnswer":"a","explanation":"Validated enables JSR-303 validation for the bound properties.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-226","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` can be registered via `@EnableConfigurationProperties` or `@ConfigurationPropertiesScan`.","options":[],"correctAnswer":true,"explanation":"Both mechanisms register configuration-properties classes.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-227","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@ConfigurationPropertiesScan` do?","options":[{"id":"a","text":"Scan for configuration-properties classes automatically"},{"id":"b","text":"Scan for components"},{"id":"c","text":"Scan for endpoints"},{"id":"d","text":"Scan for entities"}],"correctAnswer":"a","explanation":"ConfigurationPropertiesScan scans for configuration-properties classes.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-228","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` supports constructor binding with `@ConstructorBinding`.","options":[],"correctAnswer":true,"explanation":"ConstructorBinding enables immutable constructor-based binding.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-229","topicId":"spring-boot","sectionId":"configuration","type":"single-choice","prompt":"What does `@ConstructorBinding` do?","options":[{"id":"a","text":"Enable constructor-based binding for immutable configuration"},{"id":"b","text":"Enable setter binding"},{"id":"c","text":"Declare a bean"},{"id":"d","text":"Map an endpoint"}],"correctAnswer":"a","explanation":"ConstructorBinding enables constructor-based binding for immutable configuration.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-230","topicId":"spring-boot","sectionId":"configuration","type":"true-false","prompt":"`@ConfigurationProperties` supports `List` and `Map` types.","options":[],"correctAnswer":true,"explanation":"ConfigurationProperties supports List and Map types.","difficulty":"intermediate","source":"https://docs.spring.io/spring-boot/reference/features/external-config.html"},{"id":"spring-231","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@Controller` indicate?","options":[{"id":"a","text":"A web controller that can return views or response bodies"},{"id":"b","text":"A service class"},{"id":"c","text":"A repository"},{"id":"d","text":"A configuration class"}],"correctAnswer":"a","explanation":"Controller marks a web controller.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html"},{"id":"spring-232","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ResponseBody` writes the return value to the response body.","options":[],"correctAnswer":true,"explanation":"ResponseBody writes the return value to the response body.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html"},{"id":"spring-233","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@RestController` combine?","options":[{"id":"a","text":"Controller and ResponseBody"},{"id":"b","text":"Controller and RequestMapping"},{"id":"c","text":"Service and Repository"},{"id":"d","text":"Configuration and Bean"}],"correctAnswer":"a","explanation":"RestController combines Controller and ResponseBody.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html"},{"id":"spring-234","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ControllerAdvice` applies advice across controllers.","options":[],"correctAnswer":true,"explanation":"ControllerAdvice applies shared advice across controllers.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-advice.html"},{"id":"spring-235","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@RestControllerAdvice` combine?","options":[{"id":"a","text":"ControllerAdvice and ResponseBody"},{"id":"b","text":"ControllerAdvice and RequestMapping"},{"id":"c","text":"Controller and ResponseBody"},{"id":"d","text":"Service and Repository"}],"correctAnswer":"a","explanation":"RestControllerAdvice combines ControllerAdvice and ResponseBody.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-advice.html"},{"id":"spring-236","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ExceptionHandler` handles specific exceptions in a controller or advice.","options":[],"correctAnswer":true,"explanation":"ExceptionHandler handles specific exceptions.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-advice.html"},{"id":"spring-237","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@InitBinder` do?","options":[{"id":"a","text":"Customize data binding for a controller"},{"id":"b","text":"Declare a bean"},{"id":"c","text":"Map an endpoint"},{"id":"d","text":"Define a transaction"}],"correctAnswer":"a","explanation":"InitBinder customizes data binding for a controller.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-initbinder.html"},{"id":"spring-238","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ModelAttribute` binds a method parameter or return value to a model attribute.","options":[],"correctAnswer":true,"explanation":"ModelAttribute binds parameters or return values to model attributes.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-modelattrib-methods.html"},{"id":"spring-239","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@SessionAttributes` do?","options":[{"id":"a","text":"Store model attributes in the session between requests"},{"id":"b","text":"Store attributes in the request"},{"id":"c","text":"Declare a bean"},{"id":"d","text":"Map an endpoint"}],"correctAnswer":"a","explanation":"SessionAttributes stores model attributes in the session.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-sessionattrib.html"},{"id":"spring-240","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@RequestAttribute` binds a request attribute to a handler parameter.","options":[],"correctAnswer":true,"explanation":"RequestAttribute binds a request attribute.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-methods/requestattr.html"},{"id":"spring-241","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` on a class do?","options":[{"id":"a","text":"Apply transaction semantics to all public methods"},{"id":"b","text":"Apply to one method only"},{"id":"c","text":"Declare a bean"},{"id":"d","text":"Map an endpoint"}],"correctAnswer":"a","explanation":"Transactional on a class applies to all public methods.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-242","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` can specify isolation level.","options":[],"correctAnswer":true,"explanation":"Transactional supports isolation attribute.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-243","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `rollbackFor` do?","options":[{"id":"a","text":"Specify exceptions that trigger rollback"},{"id":"b","text":"Specify exceptions that do not trigger rollback"},{"id":"c","text":"Change the isolation level"},{"id":"d","text":"Declare a bean"}],"correctAnswer":"a","explanation":"rollbackFor specifies exceptions that trigger rollback.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-244","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` with `noRollbackFor` specifies exceptions that do not trigger rollback.","options":[],"correctAnswer":true,"explanation":"noRollbackFor specifies exceptions that do not trigger rollback.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-245","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `timeout` do?","options":[{"id":"a","text":"Set a timeout for the transaction"},{"id":"b","text":"Set a timeout for the request"},{"id":"c","text":"Change the isolation level"},{"id":"d","text":"Declare a bean"}],"correctAnswer":"a","explanation":"timeout sets a timeout for the transaction.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-246","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` with `readOnly = true` can optimize read-only transactions.","options":[],"correctAnswer":true,"explanation":"readOnly = true optimizes read-only transactions.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-247","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `propagation` control?","options":[{"id":"a","text":"How the transaction relates to an existing transaction"},{"id":"b","text":"The isolation level"},{"id":"c","text":"The timeout"},{"id":"d","text":"The rollback rules"}],"correctAnswer":"a","explanation":"propagation controls how the transaction relates to an existing one.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/tx-propagation.html"},{"id":"spring-248","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` with `isolation` controls the isolation level.","options":[],"correctAnswer":true,"explanation":"isolation controls the isolation level.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-249","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `label` do?","options":[{"id":"a","text":"Add descriptive labels to the transaction"},{"id":"b","text":"Change the isolation level"},{"id":"c","text":"Set a timeout"},{"id":"d","text":"Declare a bean"}],"correctAnswer":"a","explanation":"label adds descriptive labels to the transaction.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-250","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` can be used on repository interfaces.","options":[],"correctAnswer":true,"explanation":"Transactional can be used on repository interfaces.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"}]}