ocs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html"},{"id":"spring-332","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ResponseBody` writes the return value to the response body.","options":[],"correctAnswer":true,"explanation":"ResponseBody writes the return value to the response body.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html"},{"id":"spring-333","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@RestController` combine?","options":[{"id":"a","text":"Controller and ResponseBody"},{"id":"b","text":"Controller and RequestMapping"},{"id":"c","text":"Service and Repository"},{"id":"d","text":"Configuration and Bean"}],"correctAnswer":"a","explanation":"RestController combines Controller and ResponseBody.","difficulty":"beginner","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann.html"},{"id":"spring-334","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ControllerAdvice` applies advice across controllers.","options":[],"correctAnswer":true,"explanation":"ControllerAdvice applies shared advice across controllers.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-advice.html"},{"id":"spring-335","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@RestControllerAdvice` combine?","options":[{"id":"a","text":"ControllerAdvice and ResponseBody"},{"id":"b","text":"ControllerAdvice and RequestMapping"},{"id":"c","text":"Controller and ResponseBody"},{"id":"d","text":"Service and Repository"}],"correctAnswer":"a","explanation":"RestControllerAdvice combines ControllerAdvice and ResponseBody.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-advice.html"},{"id":"spring-336","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ExceptionHandler` handles specific exceptions in a controller or advice.","options":[],"correctAnswer":true,"explanation":"ExceptionHandler handles specific exceptions.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-advice.html"},{"id":"spring-337","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@InitBinder` do?","options":[{"id":"a","text":"Customize data binding for a controller"},{"id":"b","text":"Declare a bean"},{"id":"c","text":"Map an endpoint"},{"id":"d","text":"Define a transaction"}],"correctAnswer":"a","explanation":"InitBinder customizes data binding for a controller.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-initbinder.html"},{"id":"spring-338","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@ModelAttribute` binds a method parameter or return value to a model attribute.","options":[],"correctAnswer":true,"explanation":"ModelAttribute binds parameters or return values to model attributes.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-modelattrib-methods.html"},{"id":"spring-339","topicId":"spring-boot","sectionId":"web","type":"single-choice","prompt":"What does `@SessionAttributes` do?","options":[{"id":"a","text":"Store model attributes in the session between requests"},{"id":"b","text":"Store attributes in the request"},{"id":"c","text":"Declare a bean"},{"id":"d","text":"Map an endpoint"}],"correctAnswer":"a","explanation":"SessionAttributes stores model attributes in the session.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-sessionattrib.html"},{"id":"spring-340","topicId":"spring-boot","sectionId":"web","type":"true-false","prompt":"`@RequestAttribute` binds a request attribute to a handler parameter.","options":[],"correctAnswer":true,"explanation":"RequestAttribute binds a request attribute.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/web/webmvc/mvc-controller/ann-methods/requestattr.html"},{"id":"spring-341","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` on a class do?","options":[{"id":"a","text":"Apply transaction semantics to all public methods"},{"id":"b","text":"Apply to one method only"},{"id":"c","text":"Declare a bean"},{"id":"d","text":"Map an endpoint"}],"correctAnswer":"a","explanation":"Transactional on a class applies to all public methods.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-342","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` can specify isolation level.","options":[],"correctAnswer":true,"explanation":"Transactional supports isolation attribute.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-343","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `rollbackFor` do?","options":[{"id":"a","text":"Specify exceptions that trigger rollback"},{"id":"b","text":"Specify exceptions that do not trigger rollback"},{"id":"c","text":"Change the isolation level"},{"id":"d","text":"Declare a bean"}],"correctAnswer":"a","explanation":"rollbackFor specifies exceptions that trigger rollback.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-344","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` with `noRollbackFor` specifies exceptions that do not trigger rollback.","options":[],"correctAnswer":true,"explanation":"noRollbackFor specifies exceptions that do not trigger rollback.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-345","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `timeout` do?","options":[{"id":"a","text":"Set a timeout for the transaction"},{"id":"b","text":"Set a timeout for the request"},{"id":"c","text":"Change the isolation level"},{"id":"d","text":"Declare a bean"}],"correctAnswer":"a","explanation":"timeout sets a timeout for the transaction.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-346","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` with `readOnly = true` can optimize read-only transactions.","options":[],"correctAnswer":true,"explanation":"readOnly = true optimizes read-only transactions.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-347","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `propagation` control?","options":[{"id":"a","text":"How the transaction relates to an existing transaction"},{"id":"b","text":"The isolation level"},{"id":"c","text":"The timeout"},{"id":"d","text":"The rollback rules"}],"correctAnswer":"a","explanation":"propagation controls how the transaction relates to an existing one.","difficulty":"advanced","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/tx-propagation.html"},{"id":"spring-348","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` with `isolation` controls the isolation level.","options":[],"correctAnswer":true,"explanation":"isolation controls the isolation level.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-349","topicId":"spring-boot","sectionId":"data","type":"single-choice","prompt":"What does `@Transactional` with `label` do?","options":[{"id":"a","text":"Add descriptive labels to the transaction"},{"id":"b","text":"Change the isolation level"},{"id":"c","text":"Set a timeout"},{"id":"d","text":"Declare a bean"}],"correctAnswer":"a","explanation":"label adds descriptive labels to the transaction.","difficulty":"advanced","source":"https://docs.spring.io/spring-boot/reference/data-access/transaction/declarative/annotations.html"},{"id":"spring-350","topicId":"spring-boot","sectionId":"data","type":"true-false","prompt":"`@Transactional` can be used on repository interfaces.","options":[],"correctAnswer":true,"explanation":"Transactional can be used on repository interfaces.","difficulty":"intermediate","source":"https://docs.spring.io/spring-framework/reference/data-access/transaction/declarative/annotations.html"}]}